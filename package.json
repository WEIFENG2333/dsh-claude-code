{
  "name": "dsh-claude-code",
  "version": "0.1.0",
  "description": "Claude Code request and tool compatibility bundle for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./web-fetch-provider": {
      "types": "./lib/types/web-fetch-provider.d.ts",
      "default": "./lib/web-fetch-provider.js"
    },
    "./lsp-provider": {
      "types": "./lib/types/lsp-provider.d.ts",
      "default": "./lib/lsp-provider.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/**/*.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "baseline:extract": "node scripts/extract-baseline.mjs",
    "capture:compare": "node scripts/compare-captures.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src tests scripts",
    "secrets:check": "node scripts/check-secrets.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run secrets:check"
  },
  "dependencies": {
    "@deepseek-ai/dsh-lsp": "0.1.0-rc.7",
    "@deepseek-ai/dsh-lsp-stdio": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-lsp": "0.1.0-rc.7",
    "@deepseek-ai/dsh-web-fetch-http": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "acorn": "8.18.0",
    "ajv": "8.17.1",
    "eventsource-parser": "3.0.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-lsp": "0.1.0-rc.7",
    "@deepseek-ai/dsh-lsp-stdio": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@types/node": "24.3.0",
    "oxlint": "1.11.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WEIFENG2333/dsh-claude-code.git"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "claude-code",
    "agent"
  ],
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4"
}
